# ==============================================================================
# Coffee Quality MLSecOps - Environment Configuration Template
# Copy to .env for local overrides. Never commit .env containing actual secrets.
# ==============================================================================

# Application Environment (development | testing | production)
COFFEE_APP_ENV=development

# API Serving Daemon
COFFEE_API_HOST=0.0.0.0
COFFEE_API_PORT=8000
COFFEE_API_TITLE=Coffee Quality Classification Service
COFFEE_API_VERSION=0.1.0

# Filesystem Storage Paths
COFFEE_DATA_RAW_PATH=data/raw/dataset.csv
COFFEE_DATA_PROCESSED_DIR=data/processed
COFFEE_AUDIT_LOG_PATH=data/audit/audit.jsonl
COFFEE_MODEL_ARTIFACTS_DIR=artifacts/models

# MLflow Tracking & Model Registry
# Local development: sqlite:///mlflow.db
# Docker Compose stack: http://mlflow:5000
COFFEE_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
COFFEE_MLFLOW_EXPERIMENT_NAME=coffee-quality-evaluation

# Model Reproducibility & Security Controls
COFFEE_RANDOM_STATE=42
COFFEE_SPECIALTY_SCORE_THRESHOLD=80.0
COFFEE_ENABLE_ARTIFACT_INTEGRITY_CHECK=true
COFFEE_MAX_REQUEST_PAYLOAD_BYTES=1048576
